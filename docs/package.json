    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-code-group": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
